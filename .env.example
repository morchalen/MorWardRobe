# Application
APP_PORT=8080
APP_ENV=development
APP_SECRET=dev-secret-key

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=smartwardrobe_dev
DB_SSLMODE=disable

# JWT
JWT_SECRET=smartwardrobe-dev-secret-change-in-production-very-long-random-string-here
JWT_EXPIRE_HOURS=24

# VolcEngine (火山引擎)
VOLCENGINE_ACCESS_KEY_ID=your-access-key-id-here
VOLCENGINE_SECRET_ACCESS_KEY=your-secret-access-key-here
